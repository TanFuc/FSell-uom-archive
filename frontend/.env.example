# Backend API URL
# Default: http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional server-side API URL used by sitemap generation.
# Use this when NEXT_PUBLIC_API_URL points to a public URL that may not be reachable from the runtime container.
SITEMAP_API_URL=http://localhost:3001/api

# Frontend Port (for local development, if supported by script)
PORT=3000

# Frontend App URL (for Metadata/SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000
