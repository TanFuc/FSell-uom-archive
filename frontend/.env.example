# Public API / image base
NEXT_PUBLIC_API_BASE_URL=https://api.uomarchive.com
NEXT_PUBLIC_API_URL=https://api.uomarchive.com
NEXT_PUBLIC_IMAGE_BASE_URL=https://images.uomarchive.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.uomarchive.com
NEXT_PUBLIC_APP_URL=https://www.uomarchive.com

# SEO / indexing
INDEXNOW_KEY=your-indexnow-key
SITEMAP_REVALIDATE_SECRET=change-me-in-production
SEO_PING_MONITOR_WEBHOOK_URL=
SERVER_API_URL=http://127.0.0.1:8888
SITEMAP_API_URL=http://127.0.0.1:8888
SITEMAP_FETCH_TIMEOUT_MS=8000
SERVER_FETCH_TIMEOUT_MS=5000

# Low-resource Plesk defaults
UV_THREADPOOL_SIZE=1
NODE_OPTIONS=--max-old-space-size=256 --v8-pool-size=1
NEXT_PRIVATE_WORKER_THREADS=0
NEXT_TELEMETRY_DISABLED=1
