{
  "name": "fsell-uom-archive-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prepare": "lefthook install",
    "hook:install": "lefthook install",
    "cleanup:console-log": "node backend/scripts/workspace/remove-console-log.mjs",
    "cleanup:code": "node backend/scripts/workspace/cleanup-code.js --write",
    "cleanup:code:check": "node backend/scripts/workspace/cleanup-code.js --check",
    "cleanup:root:safe": "node backend/scripts/workspace/root-structure-guard.js --safe",
    "cleanup:root:hard": "node backend/scripts/workspace/root-structure-guard.js --hard",
    "cleanup:unused:backend": "npm --prefix backend run lint:fix",
    "cleanup:unused:frontend": "npm --prefix frontend run lint:fix",
    "cleanup:unused": "npm run cleanup:unused:backend && npm run cleanup:unused:frontend",
    "check:lint": "npm --prefix backend run lint:check && npm --prefix frontend run lint:check",
    "check:type": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "check:strict": "npm run cleanup:code:check && npm run check:type && npm run format:check",
    "check:strict:full": "npm run cleanup:code:check && npm run check:lint && npm run check:type && npm run format:check",
    "check:precommit": "npm run cleanup:root:hard && npm run check:type && npm run format:check",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "deploy:plesk": "node deploy-plesk.js",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./backend/scripts/workspace/deploy-production.ps1 -BackendHealthTimeoutSeconds 180",
    "deploy:prod:skip-build": "powershell -ExecutionPolicy Bypass -File ./backend/scripts/workspace/deploy-production.ps1 -SkipBuild -BackendHealthTimeoutSeconds 180",
    "deploy:prod:skip-seed": "powershell -ExecutionPolicy Bypass -File ./backend/scripts/workspace/deploy-production.ps1 -SkipSeed -BackendHealthTimeoutSeconds 180",
    "deploy:prod:linux": "sh ./backend/scripts/workspace/deploy-production.sh",
    "deploy:prod:linux:skip-build": "sh ./backend/scripts/workspace/deploy-production.sh --skip-build",
    "deploy:prod:linux:skip-seed": "sh ./backend/scripts/workspace/deploy-production.sh --skip-seed",
    "test": "cd backend && npm run test -- --runInBand && cd ../frontend && npm run test",
    "format:check": "npm --prefix backend run format:check && npm --prefix frontend run format:check",
    "docker:prod:build": "docker compose --env-file .env.prod -f docker-compose.prod.yml build",
    "docker:prod:build:backend": "docker compose --env-file .env.prod -f docker-compose.prod.yml build backend",
    "docker:prod:build:frontend": "docker compose --env-file .env.prod -f docker-compose.prod.yml build frontend",
    "docker:prod:up": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build",
    "docker:prod:up:backend": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build backend",
    "docker:prod:up:backend:stack": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build mariadb redis backend",
    "docker:prod:up:frontend": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build frontend",
    "docker:prod:up:frontend:only": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build --no-deps frontend",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env.prod -f docker-compose.prod.yml logs -f",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "docker:monitoring:up": "docker compose --env-file .env.docker --profile monitoring up -d prometheus grafana",
    "docker:monitoring:down": "docker compose --env-file .env.docker --profile monitoring down"
  },
  "devDependencies": {
    "lefthook": "^1.7.16"
  }
}
