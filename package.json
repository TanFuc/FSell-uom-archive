{
  "name": "fsell-uom-archive-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prepare": "lefthook install",
    "hook:install": "lefthook install",
    "cleanup:code": "node scripts/cleanup-code.js --write",
    "cleanup:code:check": "node scripts/cleanup-code.js --check",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1 -BackendHealthTimeoutSeconds 180",
    "deploy:prod:skip-build": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1 -SkipBuild -BackendHealthTimeoutSeconds 180",
    "deploy:prod:skip-seed": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1 -SkipSeed -BackendHealthTimeoutSeconds 180",
    "deploy:prod:linux": "sh ./scripts/deploy-production.sh",
    "deploy:prod:linux:skip-build": "sh ./scripts/deploy-production.sh --skip-build",
    "deploy:prod:linux:skip-seed": "sh ./scripts/deploy-production.sh --skip-seed",
    "test": "cd backend && npm run test -- --runInBand && cd ../frontend && npm run test",
    "format:check": "npm --prefix backend run format:check && npm --prefix frontend run format:check",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:build:backend": "docker compose -f docker-compose.prod.yml build backend",
    "docker:prod:build:frontend": "docker compose -f docker-compose.prod.yml build frontend",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:up:backend": "docker compose -f docker-compose.prod.yml up -d --build backend",
    "docker:prod:up:frontend": "docker compose -f docker-compose.prod.yml up -d --build frontend",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "lefthook": "^1.7.16"
  }
}
