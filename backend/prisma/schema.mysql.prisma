model SiteSettings {
  id    String @id @default("singleton")
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

model ThemeSettings {
  id              String @id @default("singleton")
  backgroundColor String @default("#F9F7F1")
  textColor       String @default("#4A4238")
  accentColor     String @default("#8C7E6A")

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("theme_settings")
}

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique // e.g., "menu.shop.vi", "footer.text.en"
  value String @db.Text

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("site_content")
}

model SocialSettings {
  id                String @id @default("singleton")
  facebookPageUrl   String @default("") // e.g., "https://m.me/uomarchive"
  instagramUsername String @default("") // e.g., "uomarchive"

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("social_settings")
}
