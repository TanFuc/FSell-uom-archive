// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum Language {
  VI
  EN
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  fullName     String
  role         Role    @default(MANAGER)
  isActive     Boolean @default(true)

  // Audit fields
  createdAt DateTime  @default(now())
  createdBy String? // User ID who created this record
  updatedAt DateTime  @updatedAt
  updatedBy String? // User ID who last updated
  deletedAt DateTime? // Soft delete
  deletedBy String? // User ID who deleted

  refreshToken String? @db.Text

  // Relations
  createdProducts Product[] @relation("ProductCreator")
  updatedProducts Product[] @relation("ProductUpdater")
  deletedProducts Product[] @relation("ProductDeleter")

  createdUsers User[] @relation("UserCreator")
  updatedUsers User[] @relation("UserUpdater")
  deletedUsers User[] @relation("UserDeleter")

  creator        User?    @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater        User?    @relation("UserUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter        User?    @relation("UserDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)
  createdBanners Banner[] @relation("BannerCreator")
  updatedBanners Banner[] @relation("BannerUpdater")
  banners        Banner[]

  @@map("users")
}

model Category {
  id            String  @id @default(cuid())
  slug          String  @unique
  nameVi        String
  nameEn        String
  descriptionVi String? @db.Text
  descriptionEn String? @db.Text
  image         String? // Optional category image
  order         Int     @default(0) // For sorting categories
  isActive      Boolean @default(true)

  // Audit fields
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  // Relations
  products Product[]

  @@map("categories")
}

model Product {
  id                 String @id @default(cuid())
  slug               String @unique
  nameVi             String
  nameEn             String
  shortDescriptionVi String @default("")
  shortDescriptionEn String @default("")
  descriptionVi      String @db.Text
  descriptionEn      String @db.Text

  // Category relation
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Price fields - Original/List price
  priceVND Int
  priceUSD Float? // Auto-calculated from VND if not provided

  // Sale/Discount price (nullable - only set if product is on sale)
  salePriceVND Int?
  salePriceUSD Float?

  images     Json // Array of image URLs; JSON keeps the contract compatible with MariaDB and PostgreSQL
  hoverImage String? // Image shown on hover (optional)
  material   String?
  dimensions String?
  stock      Int     @default(0)
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Inquiry feature - Replace order system
  inquiryEnabled   Boolean @default(true) // Enable/disable inquiry button
  inquiryMessageVi String  @default("") // Pre-filled message for Vietnamese
  inquiryMessageEn String  @default("") // Pre-filled message for English

  // Suggestions / Related Products
  relatedProducts Product[] @relation("RelatedProducts")
  relatedTo       Product[] @relation("RelatedProducts")

  // Sapo & E-commerce integration
  sku           String?   @unique
  sapoProductId String?   @unique

  // Relations for Cart & Order
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Audit fields
  createdAt     DateTime  @default(now())
  createdBy     String? // User ID who created this product
  updatedAt     DateTime  @updatedAt
  updatedBy     String? // User ID who last updated
  deletedAt     DateTime? // Soft delete timestamp
  deletedBy     String? // User ID who deleted
  hardDeletedAt DateTime? // Permanent delete timestamp (hidden in trash)

  // Relations for audit trail
  creator User? @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User? @relation("ProductUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter User? @relation("ProductDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@map("products")
}

model Banner {
  id String @id @default(cuid())

  titleVi       String?
  titleEn       String?
  subtitleVi    String?
  subtitleEn    String?
  descriptionVi String? @db.Text
  descriptionEn String? @db.Text

  imageUrl       String
  mobileImageUrl String?
  link           String?
  order          Int     @default(0)
  isActive       Boolean @default(true)

  // Style config
  textColor    String? @default("#FFFFFF")
  textPosition String? @default("center") // center, left, right

  // Audit fields
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  creator User?   @relation("BannerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User?   @relation("BannerUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id])
  userId  String?

  @@map("banners")
}

// ==============================================================================
// CUSTOMER & AUTH
// ==============================================================================
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  address      String?   @db.Text
  isActive     Boolean   @default(true)

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete
  hardDeletedAt DateTime? // Hard delete timestamp

  // Relations
  carts  Cart[]
  orders Order[]

  @@map("customers")
}

// ==============================================================================
// CART & CART ITEMS
// ==============================================================================
model Cart {
  id         String   @id @default(cuid())
  customerId String?
  sessionId  String?  @unique

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  hardDeletedAt DateTime?

  // Relations
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([sessionId])
  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)
  priceVND  Int

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  hardDeletedAt DateTime?

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ==============================================================================
// ORDER & ORDER ITEMS (Sapo Integrated)
// ==============================================================================
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerId      String?
  customerEmail   String
  customerName    String
  shippingAddress String   @db.Text
  phoneNumber     String
  note            String?  @db.Text
  totalVND        Int
  status          String   @default("pending") // pending | processing | shipped | delivered | cancelled
  isDraft         Boolean  @default(false)     // cờ phân biệt đơn nháp và đơn đã đặt

  // Sapo Integration fields
  sapoOrderId           String?   @unique
  sapoOrderNumber       String?
  sapoFulfillmentStatus String?
  sapoFinancialStatus   String?   @default("pending")
  trackingCompany       String?
  trackingNumber        String?
  trackingUrl           String?   @db.Text

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  hardDeletedAt DateTime?

  // Relations
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([customerId])
  @@index([sapoOrderId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  productTitle   String
  productSku     String?
  productImage   String?
  quantity       Int
  priceVND       Int
  sapoVariantId  String?

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  hardDeletedAt DateTime?

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==============================================================================
// SAPO WEBHOOK LOGS
// ==============================================================================
model SapoWebhookLog {
  id           String   @id @default(cuid())
  topic        String
  sapoOrderId  String?
  payload      Json
  status       String   @default("processed")
  errorMessage String?  @db.Text

  // Audit fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  hardDeletedAt DateTime?

  @@index([topic])
  @@index([sapoOrderId])
  @@map("sapo_webhook_logs")
}

model SiteSettings {
  id    String @id @default("singleton")
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

model ThemeSettings {
  id              String @id @default("singleton")
  backgroundColor String @default("#F9F7F1")
  textColor       String @default("#4A4238")
  accentColor     String @default("#8C7E6A")

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("theme_settings")
}

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique // e.g., "menu.shop.vi", "footer.text.en"
  value String @db.Text

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("site_content")
}

model SocialSettings {
  id                String @id @default("singleton")
  facebookPageUrl   String @default("") // e.g., "https://m.me/uomarchive"
  instagramUsername String @default("") // e.g., "uomarchive"

  updatedAt DateTime @updatedAt
  updatedBy String? // User ID who last updated

  @@map("social_settings")
}
