# App runtime
PORT=8888
FRONTEND_URL="https://www.uomarchive.com"
FRONTEND_URLS="https://www.uomarchive.com"
NODE_ENV="production"

# Database
# MariaDB default. PostgreSQL remains available via scripts/prisma-switch.mjs.
DATABASE_URL="mysql://uom_user:uom_password@localhost:3306/uom_archive"
DB_DRIVER="mariadb"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# JWT
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Upload / storage
UPLOAD_PROVIDER="r2"
IMAGE_BASE_URL="https://images.uomarchive.com"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_KEY="your-r2-access-key"
R2_SECRET="your-r2-secret-key"
R2_BUCKET="uom-archive"
R2_PUBLIC_URL="https://images.uomarchive.com"
R2_PUBLIC_BASE_URL="https://images.uomarchive.com"

