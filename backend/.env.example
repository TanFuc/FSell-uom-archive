# Database
DATABASE_URL="postgresql://uom_user:uom_password@localhost:5432/uom_archive"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"
BASE_URL="http://localhost:3001"
NODE_ENV="development"

# Email Notifications (will be overridden by DB settings)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
ADMIN_EMAIL="admin@uomarchive.com"

# Zalo Notifications (Optional)
ZALO_OA_ID=""
ZALO_ACCESS_TOKEN=""
ZALO_TEMPLATE_ID=""
ADMIN_PHONE=""

# Facebook Messenger (Optional)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
