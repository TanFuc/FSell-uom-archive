# Database
DATABASE_URL="postgresql://uom_user:uom_password@localhost:5432/uom_archive"

# Redis - Local (Development)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Redis - Upstash (Production)
# Get these from https://console.upstash.com/
UPSTASH_REDIS_URL="rediss://your-upstash-url:6379"
UPSTASH_REDIS_TOKEN="your-upstash-token"

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000"
BASE_URL="http://localhost:3001"
NODE_ENV="development"

# Cloudinary - Image Upload Service
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="uom-archive"

# Upload provider: cloudinary | r2
UPLOAD_PROVIDER="r2"

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_KEY="your-r2-access-key"
R2_SECRET="your-r2-secret-key"
R2_BUCKET="my-app-images"
R2_PUBLIC_URL="https://cdn.yourdomain.com"

# Grafana Alerting (used by docker-compose monitoring profile)
GF_ALERT_TELEGRAM_BOT_TOKEN=""
GF_ALERT_TELEGRAM_CHAT_ID=""
GF_ALERT_SLACK_WEBHOOK_URL=""
GF_ALERT_EMAIL_ADDRESSES="ops@example.com"

# SMTP for Grafana Email contact point
GF_SMTP_ENABLED="false"
GF_SMTP_HOST="smtp.example.com:587"
GF_SMTP_USER=""
GF_SMTP_PASSWORD=""
GF_SMTP_FROM_ADDRESS="alerts@uom.local"
GF_SMTP_FROM_NAME="UOM Alerts"

