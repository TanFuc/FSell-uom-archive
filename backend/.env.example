# App runtime
PORT=8888
FRONTEND_URL="https://www.uomarchive.com"
FRONTEND_URLS="https://www.uomarchive.com,https://uomarchive.com"
NODE_ENV="production"
UV_THREADPOOL_SIZE=1
PRISMA_CLIENT_ENGINE_TYPE="library"
NODE_OPTIONS="--max-old-space-size=256 --v8-pool-size=1"
SHARP_CONCURRENCY=1
REQUEST_LOGGING_ENABLED=false
SLOW_REQUEST_LOGGING_MS=1500
METRICS_ENABLED=false
PASSENGER_FORCE_MAX_CONCURRENT_REQUESTS_PER_PROCESS=0
PUBLIC_CACHE_MAX_AGE_SECONDS=300
PUBLIC_CACHE_S_MAXAGE_SECONDS=3600
PUBLIC_CACHE_STALE_WHILE_REVALIDATE_SECONDS=86400

# Database
# MariaDB default. PostgreSQL remains available via scripts/prisma-switch.mjs.
DATABASE_URL="mysql://<db-user>:<url-encoded-db-password>@127.0.0.1:3306/<db-name>?connection_limit=2&pool_timeout=5"
DB_DRIVER="mariadb"

# Redis
# Use Upstash's Redis URL here when deploying without a local Redis service.
REDIS_URL="rediss://default:<upstash-password>@<upstash-host>.upstash.io:6379"
REDIS_PASSWORD=""
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
# Optional alias. If set, it takes priority over REDIS_URL.
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# JWT
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Upload / storage
UPLOAD_PROVIDER="r2"
IMAGE_BASE_URL="https://images.uomarchive.com"
R2_ENDPOINT="https://a306a6537d4f7153be77b993ee2253d1.r2.cloudflarestorage.com"
R2_KEY="<r2-access-key-id>"
R2_SECRET="<r2-secret-access-key>"
R2_BUCKET="uom-archive"
R2_PUBLIC_URL="https://images.uomarchive.com"
R2_PUBLIC_BASE_URL="https://images.uomarchive.com"
