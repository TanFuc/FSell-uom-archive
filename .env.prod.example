# ===============================
# Minimal production environment
# Stack: Postgres + Redis + JWT + Cloudinary/R2
# ===============================

NODE_ENV=production

# Ports (host -> container)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=uom_archive

# Redis
REDIS_PASSWORD=change_this_redis_password

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITEMAP_API_URL=http://localhost:3001/api

# Upload provider: cloudinary | r2
UPLOAD_PROVIDER=r2

# Cloudinary (required when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=uom-archive

# Cloudflare R2 (required when UPLOAD_PROVIDER=r2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_KEY=your-r2-access-key
R2_SECRET=your-r2-secret-key
R2_BUCKET=uom-archive-images
R2_PUBLIC_URL=https://cdn.yourdomain.com
