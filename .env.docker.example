# Copy this file to .env.docker and use with:
# docker compose --env-file .env.docker up -d --build

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# PostgreSQL
POSTGRES_USER=uom_user
POSTGRES_PASSWORD=uom_password
POSTGRES_DB=uom_archive

# Redis
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upload provider: cloudinary | r2
UPLOAD_PROVIDER=r2

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uom-archive

# Cloudflare R2 (optional)
R2_ENDPOINT=
R2_KEY=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=

# Upstash (optional, production-style)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Grafana auth
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana alerting contact points
GF_ALERT_TELEGRAM_BOT_TOKEN=
GF_ALERT_TELEGRAM_CHAT_ID=
GF_ALERT_SLACK_WEBHOOK_URL=
GF_ALERT_EMAIL_ADDRESSES=ops@example.com

# SMTP for Grafana email notifications
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@uom.local
GF_SMTP_FROM_NAME=UOM Alerts
